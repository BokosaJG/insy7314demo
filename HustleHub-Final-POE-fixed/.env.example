# Docker Compose settings. Copy to ".env" (never commit the real file).

# MongoDB root account (used only inside the Docker network)
MONGO_ROOT_USER=hustlehub
# Use letters and digits only (the password is placed inside a connection URL).
MONGO_ROOT_PASSWORD=replace_with_letters_and_digits_only

# Signing secret for JWTs - must be 32+ random characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters

# First Admin account (created automatically on first start)
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# Origin the browser uses for the web app (CORS allow-list on the API)
CLIENT_ORIGIN=http://localhost:8080

# Persistent account lockout: failed sign-ins before the account is locked, and for how long.
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=15

# Logging
LOG_LEVEL=info
# Cloud logging with Better Stack (optional - see README "Logging"). Leave empty to disable.
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_INGESTING_HOST=
