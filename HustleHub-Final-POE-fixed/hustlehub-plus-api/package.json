{
  "name": "hustlehub-plus-api",
  "version": "1.0.0",
  "description": "HustleHub+ secure backend API - Final POE: DevSecOps, monitoring and finalisation",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "lint:report": "eslint . -f json -o reports/eslint-report.json",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "test:api": "newman run postman/HustleHub-Plus-Final.postman_collection.json -e postman/HustleHub-Local.postman_environment.json --insecure --color on -r cli,json,htmlextra --reporter-json-export reports/newman-report.json --reporter-htmlextra-export reports/newman-report.html --reporter-htmlextra-title \"HustleHub+ Final POE - API Tests\" --reporter-htmlextra-browserTitle \"HustleHub+ Newman Report\"",
    "test:api:ci": "newman run postman/HustleHub-Plus-Final.postman_collection.json -e postman/HustleHub-Local.postman_environment.json --insecure -r cli,json --reporter-json-export reports/newman-report.json"
  },
  "keywords": [
    "mern",
    "express",
    "jwt",
    "secure-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@logtail/node": "^0.6.1",
    "@logtail/winston": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
